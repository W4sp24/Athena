# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Mode: backtest | paper | testnet   (there is no live mode — see CLAUDE.md)
CRYPTOLAB_MODE=paper

# Exchange TESTNET credentials only (trade-only, withdrawals disabled)
CRYPTOLAB_TESTNET_API_KEY=
CRYPTOLAB_TESTNET_API_SECRET=

# Optional alerting (reconciliation / kill-switch trips)
CRYPTOLAB_TELEGRAM_BOT_TOKEN=
CRYPTOLAB_TELEGRAM_CHAT_ID=

# Local LLM server (OpenAI-compatible)
CRYPTOLAB_LLM_BASE_URL=http://localhost:8000/v1
